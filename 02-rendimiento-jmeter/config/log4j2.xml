<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>
        <File name="JMeter" fileName="${sys:jmeter.logfile:-jmeter.log}" append="false">
            <PatternLayout pattern="%d{ISO8601} %p %c{1.} %m%n"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="info"><AppenderRef ref="JMeter"/></Root>
    </Loggers>
</Configuration>
